# Copy to .env and set the password. That is all.

# The ADMIN login: for you, your apps and the modbee command. Devices get
# logins of their own (README.md). User name "admin" unless MQTT_USERNAME says.
MQTT_PASSWORD=
# MQTT_USERNAME=admin

# --- Optional -------------------------------------------------------------
# MQTT_PORT=1883                 # the port devices connect to
# MQTT_BIND=0.0.0.0              # 127.0.0.1: this server only; or one interface's address
# MODBEE_VERSION=latest          # or a release, e.g. 0.1.0
# MODBEE_NETWORK=modbee          # the Docker network your own apps join

# Kafka for apps outside Docker, at localhost:9094 (no password). To let other
# machines on your own network in as well, set both:
# KAFKA_BIND=0.0.0.0                 # listen on every interface, not just this server
# KAFKA_EXTERNAL_HOST=192.168.1.20   # the address those machines use for this server
# KAFKA_PORT=9094
