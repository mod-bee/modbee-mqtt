# Copy to .env and fill in the three settings. That is all.

# The name devices connect to. Point its DNS A record at this server first.
DOMAIN=mqtt.example.com

# Let's Encrypt sends certificate expiry warnings here (renewal is automatic).
EMAIL=you@example.com

# The ADMIN login: for you, your apps and the modbee command. The broker is on
# the internet: choose a long password. Devices get logins of their own
# (README.md). User name "admin" unless MQTT_USERNAME says.
MQTT_PASSWORD=
# MQTT_USERNAME=admin

# --- Optional -------------------------------------------------------------
# MODBEE_VERSION=latest          # or a release, e.g. 0.1.0
# MODBEE_NETWORK=modbee          # the Docker network your own apps join
# HTTP_PORT=80                   # must reach this server as port 80 for Let's Encrypt
# MQTTS_PORT=8883                # what devices connect to
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory   # practise first
