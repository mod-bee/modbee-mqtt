# Copy to .env and set the password. That is all.

# The ADMIN login: for you, your apps and the modbee command. The broker is on
# the internet: choose a long password. Devices get logins of their own
# (README.md). User name "admin" unless MQTT_USERNAME says.
MQTT_PASSWORD=
# MQTT_USERNAME=admin

# --- Optional -------------------------------------------------------------
# MODBEE_VERSION=latest          # or a release, e.g. 0.1.0
