# Copy this file to .env and fill in the three settings below. That is all.

# The name devices connect to. Point its DNS A record at this server first.
DOMAIN=mqtt.example.com

# Let's Encrypt sends certificate expiry warnings here (renewal is automatic).
EMAIL=you@example.com

# The ADMIN login: for you, your own apps and the modbee command. Choose a long
# password - the broker is on the internet. Devices get logins of their own
# (docs/logins.md). The user name is "admin" unless MQTT_USERNAME says otherwise.
MQTT_PASSWORD=
# MQTT_USERNAME=admin

# --- Optional -------------------------------------------------------------
# MODBEE_VERSION=latest          # or a release, e.g. 1.0.0
# MODBEE_IMAGE=ghcr.io/mod-bee/modbee-mqtt:latest   # another image; replaces MODBEE_VERSION
# MODBEE_NETWORK=modbee         # the network other compose projects join (docs/docker.md)
# HTTP_PORT=80                   # must reach this server as port 80 for Let's Encrypt
# MQTTS_PORT=8883                # what devices connect to
# ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory   # practise first

# Kafka from anywhere, with a login: set a password, and apps connect to
# DOMAIN:9093 over TLS (SASL_SSL, mechanism PLAIN) as KAFKA_USERNAME. Leave
# it blank and port 9093 lets nobody in. No double quotes in the password.
KAFKA_PASSWORD=
# KAFKA_USERNAME=app
# KAFKA_TLS_PORT=9093

# Kafka with NO login, for this server, at localhost:9094. To let other
# machines on your own network in as well (a LAN or VPN), set both:
# KAFKA_BIND=0.0.0.0             # listen on every interface, not just this server
# KAFKA_EXTERNAL_HOST=192.168.1.20   # the address those machines use for this server
# KAFKA_PORT=9094
# This Kafka has no password: never open its port to the internet.
