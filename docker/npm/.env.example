# Copy this file to .env and fill in the three settings below.

# The name devices and your SCADA connect to (the certificate NPM holds).
DOMAIN=broker.example.com

# The ADMIN login: for you, your own apps and the modbee command. Choose a long
# password - the broker is on the internet. Devices get logins of their own
# (docs/logins.md). The user name is "admin" unless MQTT_USERNAME says otherwise.
MQTT_PASSWORD=
# MQTT_USERNAME=admin

# Kafka for your SCADA, through NPM on DOMAIN:9093 (SASL PLAIN), as KAFKA_USERNAME.
# No double quotes in the password.
KAFKA_PASSWORD=
# KAFKA_USERNAME=app
